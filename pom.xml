<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.travel</groupId>
    <artifactId>travel-agent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>travel-agent</name>
    <description>智能旅行规划 Agent - 芋道模块化架构</description>

    <modules>
        <!-- Common 公共模块 -->
        <module>travel-common</module>

        <!-- MCP 父工程（包含 7 个子模块） -->
        <module>travel-module-mcp-biz</module>

        <!-- 业务模块（按依赖顺序） -->
        <module>travel-module-user-biz</module>
        <module>travel-module-commerce-biz</module>
        <module>travel-module-auth-biz</module>
        <module>travel-module-agent-biz</module>
        <module>travel-module-itinerary-biz</module>
        <module>travel-module-note-biz</module>

        <!-- A2A 运行时 -->
        <module>travel-a2a-runtime</module>

        <!-- Web 入口 -->
        <module>travel-web</module>
    </modules>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.4</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis-plus.version>3.5.5</mybatis-plus.version>
        <spring-ai.version>1.0.0-M4</spring-ai.version>
        <hutool.version>5.8.23</hutool.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 项目内部模块 -->
            <dependency>
                <groupId>com.travel</groupId>
                <artifactId>travel-module-auth-biz</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.travel</groupId>
                <artifactId>travel-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.travel</groupId>
                <artifactId>travel-module-mcp-biz</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
            </dependency>
            <dependency>
                <groupId>com.travel</groupId>
                <artifactId>travel-mcp-protocol</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.travel</groupId>
                <artifactId>travel-mcp-client</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.travel</groupId>
                <artifactId>travel-mcp-server-weather</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.travel</groupId>
                <artifactId>travel-mcp-server-poi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.travel</groupId>
                <artifactId>travel-mcp-server-meal</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.travel</groupId>
                <artifactId>travel-mcp-server-budget</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.travel</groupId>
                <artifactId>travel-mcp-server-itinerary</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.travel</groupId>
                <artifactId>travel-a2a-runtime</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.travel</groupId>
                <artifactId>travel-module-agent-biz</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.travel</groupId>
                <artifactId>travel-module-itinerary-biz</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.travel</groupId>
                <artifactId>travel-module-note-biz</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.travel</groupId>
                <artifactId>travel-module-user-biz</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.travel</groupId>
                <artifactId>travel-module-commerce-biz</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Spring AI BOM -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Hutool -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- MyBatis Plus -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Hutool -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>${hutool.version}</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>spring-milestones</id>
            <name>Spring Milestones</name>
            <url>https://repo.spring.io/milestone</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>
</project>
